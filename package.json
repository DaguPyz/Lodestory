{
  "name": "lodestory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:sdk && vite",
    "dev:sdk": "pnpm --filter @lodestory/sdk dev",
    "dev:desktop": "tauri dev",
    "build:sdk": "pnpm --filter @lodestory/sdk build",
    "build": "pnpm run build:sdk && tsc && vite build",
    "test": "pnpm run build:sdk && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lodestory/sdk": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
