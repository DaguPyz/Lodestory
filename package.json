{
  "name": "lodestory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:packages && node scripts/dev-with-sdk.mjs",
    "dev:sdk": "pnpm --filter @lodestory/sdk dev",
    "dev:ui": "pnpm --filter @lodestory/ui dev",
    "dev:desktop": "tauri dev",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:theme": "node scripts/generate-theme-assets.mjs",
    "generate:theme-docs": "node scripts/generate-theme-docs.mjs",
    "check:theme-standard": "node scripts/verify-theme-standard.mjs",
    "build:sdk": "pnpm run generate:theme && pnpm --filter @lodestory/sdk build",
    "build:ui": "pnpm --filter @lodestory/ui build",
    "build:packages": "pnpm run build:sdk && pnpm run build:ui",
    "build": "pnpm run build:packages && tsc && vite build",
    "test": "pnpm run build:packages && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lodestory/sdk": "workspace:*",
    "@lodestory/ui": "workspace:*",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "decode-named-character-reference": "1.3.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "quill": "2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
