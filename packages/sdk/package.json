{
  "name": "@lodestory/sdk",
  "version": "0.1.0",
  "description": "Lodestory plugin contracts and shared capability keys",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./navigation-layout": {
      "types": "./dist/navigation-layout.d.ts",
      "import": "./dist/navigation-layout.js"
    },
    "./window-shell": {
      "types": "./dist/window-shell.d.ts",
      "import": "./dist/window-shell.js"
    },
    "./workbench": {
      "types": "./dist/workbench.d.ts",
      "import": "./dist/workbench.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./project-storage": {
      "types": "./dist/project-storage.d.ts",
      "import": "./dist/project-storage.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "import": "./dist/documents.js"
    },
    "./body-editor": {
      "types": "./dist/body-editor.d.ts",
      "import": "./dist/body-editor.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./context-menu": {
      "types": "./dist/context-menu.d.ts",
      "import": "./dist/context-menu.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@types/react": "^19.1.8"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "typescript": "~6.0.3"
  }
}
