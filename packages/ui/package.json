{
  "name": "@lodestory/ui",
  "version": "0.1.0",
  "description": "Lodestory shared React components",
  "license": "UNLICENSED",
  "type": "module",
  "files": ["dist", "styles.css", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "~6.0.3"
  }
}
