+        return button && textOf(button) === PROJECT_NAME ? button : null;
+      },
+      `workbench toolbar after round ${roundNumber}`,
+    );
+    round.toolbarAtMs = performance.now();
+    round.openToToolbarMs = round.toolbarAtMs - round.openClickAtMs;
+    mark("workbench-toolbar-ready", {round: roundNumber, latencyMs: round.openToToolbarMs});
+
+    state.phase = "timeline-list";
+    const outlineToggle = await waitFor(
+      () => activeOne('button[aria-label="大纲设计"]'),
+      `outline toggle after round ${roundNumber}`,
+    );
+    if (outlineToggle.getAttribute("aria-pressed") !== "true") outlineToggle.click();
+    await waitFor(rowsReady, `26 timeline rows with no loading state after round ${roundNumber}`);
+    round.timelineListReadyAtMs = performance.now();
+    round.openToTimelineListReadyMs = round.timelineListReadyAtMs - round.openClickAtMs;
+    round.timelineRowCount = activeAll(".outline-design-entry").length;
+    mark("timeline-list-ready", {round: roundNumber, latencyMs: round.openToTimelineListReadyMs, rowCount: round.timelineRowCount});
+    const completeTimelineData = await waitFor(() => {
+      const snapshot = timelineDataSnapshot();
+      return snapshot.complete ? snapshot : null;
+    }, `complete timeline titles, counts totaling ${EXPECTED_EVENT_COUNT}, and periods after round ${roundNumber}`);
+    round.allDataReadyAtMs = performance.now();
+    round.allDataReadyMs = round.allDataReadyAtMs - round.openClickAtMs;
+    round.timelineData = completeTimelineData.rows;
+    round.timelineEventCountTotal = completeTimelineData.totalEventCount;
+    mark("all-data-ready", {
+      round: roundNumber,
+      latencyMs: round.allDataReadyMs,
+      timelineCount: completeTimelineData.rows.length,
+      eventCountTotal: completeTimelineData.totalEventCount,
+    });
+
+    state.phase = "first-timeline-canvas";
+    const first = findTimeline(FIRST_TIMELINE);
+    if (!first) throw new Error(`Could not find first timeline: ${FIRST_TIMELINE}`);
+    first.click();
+    await waitFor(() => {
+      const axis = activeOne(".timeline-axis-svg");
+      return axis?.getAttribute("aria-label")?.includes(FIRST_TIMELINE)
+        && !activeAll(".timeline-axis-feedback[role=status]").length
+        && visibleTimelineTitles().length > 0
+        ? axis : null;
+    }, `first timeline canvas with visible event titles after round ${roundNumber}`);
+    round.firstCanvasReadyAtMs = performance.now();
+    round.openToFirstCanvasReadyMs = round.firstCanvasReadyAtMs - round.openClickAtMs;
+    round.firstTimelineEventTitleCount = visibleTimelineTitles().length;
+    round.firstTimelineEventTitles = visibleTimelineTitles().map(textOf);
