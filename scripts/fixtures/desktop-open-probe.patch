+    mark("round-start", {round: roundNumber});
+    const openButton = await waitFor(
+      () => activeAll(`.project-entry[aria-label="打开项目 ${PROJECT_NAME}"]:not(:disabled)`)[0],
+      `recent project button for ${PROJECT_NAME}`,
+    );
+    round.openClickAtMs = performance.now();
+    openButton.click();
+    mark("project-open-click", {round: roundNumber});
+    const toolbar = await waitFor(
+      () => {
