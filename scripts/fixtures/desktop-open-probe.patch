+      ...state,
+      commandMeasurements: "native Rust command and store action timings are attached by the desktop report command",
+      timingSummary: {
+        openToToolbar: durationStats(state.rounds.map(round => round.openToToolbarMs).filter(Number.isFinite)),
+        openToTimelineListReady: durationStats(state.rounds.map(round => round.openToTimelineListReadyMs).filter(Number.isFinite)),
+        openToAllDataReady: durationStats(state.rounds.map(round => round.allDataReadyMs).filter(Number.isFinite)),
+        openToFirstCanvasReady: durationStats(state.rounds.map(round => round.openToFirstCanvasReadyMs).filter(Number.isFinite)),
+        projectCloseToWelcome: durationStats(state.rounds.map(round => round.projectCloseToWelcomeMs).filter(Number.isFinite)),
