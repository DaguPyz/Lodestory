diff --git a/src-tauri/src/desktop_perf.rs b/src-tauri/src/desktop_perf.rs
new file mode 100644
index 0000000..b0d6beb
--- /dev/null
+++ b/src-tauri/src/desktop_perf.rs
@@ -0,0 +1,215 @@
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+use std::time::Duration;
+use tauri::Manager;
+#[cfg(target_os = "macos")]
+use objc2_app_kit::{NSApplicationActivationOptions, NSRunningApplication};
+
+static NATIVE_COMMANDS: OnceLock<Mutex<Vec<Value>>> = OnceLock::new();
+static NATIVE_ACTIONS: OnceLock<Mutex<BTreeMap<&'static str, ActionAggregate>>> = OnceLock::new();
+
+#[derive(Clone, Default)]
+struct ActionAggregate {
+    count: u64,
+    total_ms: f64,
+    max_ms: f64,
+}
+
+pub fn record_native(command: &'static str, elapsed: Duration) {
+    let calls = NATIVE_COMMANDS.get_or_init(|| Mutex::new(Vec::new()));
+    if let Ok(mut calls) = calls.lock() {
+        calls.push(json!({
+            "command": command,
+            "durationMs": elapsed.as_secs_f64() * 1000.0,
+        }));
+    }
+}
+
+pub fn record_native_action(action: &'static str, elapsed: Duration) {
+    let actions = NATIVE_ACTIONS.get_or_init(|| Mutex::new(BTreeMap::new()));
+    if let Ok(mut actions) = actions.lock() {
+        let aggregate = actions.entry(action).or_default();
+        let elapsed_ms = elapsed.as_secs_f64() * 1000.0;
+        aggregate.count += 1;
+        aggregate.total_ms += elapsed_ms;
+        aggregate.max_ms = aggregate.max_ms.max(elapsed_ms);
+    }
+}
+
+fn take_native_calls() -> Vec<Value> {
+    NATIVE_COMMANDS
+        .get_or_init(|| Mutex::new(Vec::new()))
+        .lock()
+        .map(|mut calls| std::mem::take(&mut *calls))
+        .unwrap_or_default()
+}
+
+fn take_native_actions() -> Value {
+    let actions = NATIVE_ACTIONS.get_or_init(|| Mutex::new(BTreeMap::new()));
+    let Ok(mut actions) = actions.lock() else {
+        return json!({});
+    };
+    let snapshot = std::mem::take(&mut *actions);
+    let mut result = serde_json::Map::new();
+    for (name, metrics) in snapshot {
+        result.insert(name.to_owned(), json!({
+            "count": metrics.count,
+            "totalMs": metrics.total_ms,
+            "meanMs": if metrics.count == 0 { 0.0 } else { metrics.total_ms / metrics.count as f64 },
+            "maxMs": metrics.max_ms,
+        }));
+    }
+    Value::Object(result)
+}
+
+pub fn current_native_snapshot() -> Value {
+    let commands = NATIVE_COMMANDS
+        .get_or_init(|| Mutex::new(Vec::new()))
+        .lock()
+        .map(|commands| commands.clone())
+        .unwrap_or_default();
+    let actions = NATIVE_ACTIONS.get_or_init(|| Mutex::new(BTreeMap::new()));
+    let mut action_snapshot = serde_json::Map::new();
+    if let Ok(actions) = actions.lock() {
+        for (name, metrics) in actions.iter() {
+            action_snapshot.insert((*name).to_owned(), json!({
+                "count": metrics.count,
+                "totalMs": metrics.total_ms,
+                "meanMs": if metrics.count == 0 { 0.0 } else { metrics.total_ms / metrics.count as f64 },
+                "maxMs": metrics.max_ms,
+            }));
+        }
+    }
+    json!({"nativeCommands": commands, "nativeActions": Value::Object(action_snapshot)})
+}
+
+#[tauri::command]
+pub fn desktop_perf_progress(payload: Value) {
+    write_progress(payload);
+}
+
+#[tauri::command]
+pub fn desktop_perf_focus(app: tauri::AppHandle) -> Result<Value, String> {
+    #[cfg(target_os = "macos")]
+    let mut operation_errors = Vec::new();
+    #[cfg(target_os = "macos")]
+    if let Err(error) = app.show() {
+        operation_errors.push(format!("app.show: {error}"));
+    }
+
+    let window = app
+        .get_webview_window("main")
+        .ok_or_else(|| "main webview window is not available".to_owned())?;
+    for (operation, result) in [
+        ("unminimize", window.unminimize()),
+        ("center", window.center()),
+        ("show", window.show()),
+        ("set_always_on_top", window.set_always_on_top(true)),
+        ("set_visible_on_all_workspaces", window.set_visible_on_all_workspaces(true)),
+    ] {
+        if let Err(error) = result {
+            operation_errors.push(format!("{operation}: {error}"));
+        }
+    }
+    #[cfg(target_os = "macos")]
+    if !NSRunningApplication::currentApplication().activateWithOptions(
+        NSApplicationActivationOptions::ActivateIgnoringOtherApps
+            | NSApplicationActivationOptions::ActivateAllWindows,
+    ) {
+        operation_errors.push("NSRunningApplication.activateWithOptions returned false".to_owned());
+    }
+    if let Err(error) = window.set_focus() {
+        operation_errors.push(format!("window.set_focus: {error}"));
+    }
+    if let Err(error) = window.as_ref().set_focus() {
+        operation_errors.push(format!("webview.set_focus: {error}"));
+    }
+
+    let visibility = window.is_visible();
+    let minimized = window.is_minimized();
+    let focused = window.is_focused();
+    let inner_size = window.inner_size();
+    let outer_position = window.outer_position();
+    let query_errors = [
+        visibility.as_ref().err().map(|error| format!("is_visible: {error}")),
+        minimized.as_ref().err().map(|error| format!("is_minimized: {error}")),
+        focused.as_ref().err().map(|error| format!("is_focused: {error}")),
+        inner_size.as_ref().err().map(|error| format!("inner_size: {error}")),
+        outer_position.as_ref().err().map(|error| format!("outer_position: {error}")),
+    ]
+    .into_iter()
+    .flatten()
+    .collect::<Vec<_>>();
+    Ok(json!({
+        "isVisible": visibility.as_ref().ok(),
+        "isMinimized": minimized.as_ref().ok(),
+        "isFocused": focused.as_ref().ok(),
+        "innerSize": inner_size.as_ref().ok().map(|size| json!({"width": size.width, "height": size.height})),
+        "outerPosition": outer_position.as_ref().ok().map(|position| json!({"x": position.x, "y": position.y})),
+        "queryErrors": query_errors,
+        "operationErrors": operation_errors,
+    }))
+}
+
+pub fn write_progress(payload: Value) {
+    let line = serde_json::to_string(&payload).unwrap_or_else(|error| {
+        format!("{{\"serializationError\":{:?}}}", error.to_string())
+    });
+    eprintln!("DESKTOP_PERF_PROGRESS {line}");
+    let Some(path) = std::env::var_os("LODESTORY_PERF_PROGRESS") else {
+        return;
+    };
+    if let Some(parent) = std::path::Path::new(&path).parent() {
+        if let Err(error) = std::fs::create_dir_all(parent) {
+            eprintln!("DESKTOP_PERF_PROGRESS_WRITE_FAILED directory: {error}");
+            return;
+        }
+    }
+    match std::fs::OpenOptions::new().create(true).append(true).open(&path) {
+        Ok(mut file) => {
+            if let Err(error) = writeln!(file, "{line}") {
+                eprintln!("DESKTOP_PERF_PROGRESS_WRITE_FAILED append: {error}");
+            }
+        }
+        Err(error) => eprintln!("DESKTOP_PERF_PROGRESS_WRITE_FAILED open: {error}"),
+    }
+}
+
+#[tauri::command]
+pub fn desktop_perf_report(app: tauri::AppHandle, report: Value) -> Result<(), String> {
+    let Some(output_path) = std::env::var_os("LODESTORY_PERF_OUTPUT") else {
+        eprintln!("DESKTOP_PERF_REPORT_FAILED: LODESTORY_PERF_OUTPUT is not set");
+        app.exit(2);
+        return Err("LODESTORY_PERF_OUTPUT is not set".to_owned());
+    };
+    let report = json!({
+        "frontend": report,
+        "nativeCommands": take_native_calls(),
+        "nativeActions": take_native_actions(),
+    });
+    let bytes = match serde_json::to_vec_pretty(&report) {
+        Ok(bytes) => bytes,
+        Err(error) => {
+            eprintln!("DESKTOP_PERF_REPORT_FAILED: serialization: {error}");
+            app.exit(2);
+            return Err(error.to_string());
+        }
+    };
+    if let Some(parent) = std::path::Path::new(&output_path).parent() {
+        if let Err(error) = std::fs::create_dir_all(parent) {
+            eprintln!("DESKTOP_PERF_REPORT_FAILED: output directory: {error}");
+            app.exit(2);
+            return Err(error.to_string());
+        }
+    }
+    if let Err(error) = std::fs::write(&output_path, &bytes) {
+        eprintln!("DESKTOP_PERF_REPORT_FAILED: output file: {error}");
+        app.exit(2);
+        return Err(format!("could not write measurement report: {error}"));
+    }
+    eprintln!("DESKTOP_PERF_REPORT {}", std::path::PathBuf::from(&output_path).display());
+    app.exit(0);
+    Ok(())
+}
diff --git a/src-tauri/src/desktop_perf_probe.js b/src-tauri/src/desktop_perf_probe.js
new file mode 100644
index 0000000..86b851d
--- /dev/null
+++ b/src-tauri/src/desktop_perf_probe.js
@@ -0,0 +1,533 @@
+(() => {
+  if (window.__desktopPerf?.harnessVersion === "desktop-open-stage2-v3") return;
+  const PROJECT_NAME = "测试项目";
+  const FIRST_TIMELINE = "00 · 全书关键剧情";
+  const SECOND_TIMELINE = "01 · 原文细读 0001—0100";
+  const ROUND_COUNT = 5;
+  const EXPECTED_TIMELINE_COUNT = 26;
+  const EXPECTED_EVENT_COUNT = 2158;
+  const BETWEEN_ROUND_SETTLE_MS = 100;
+  const WAIT_MS = 30000;
+  const PROFILE_MODE = new URL(window.location.href).searchParams.get("desktopPerfProfile") === "1";
+  const timeOrigin = performance.now();
+
+  const state = {
+    mode: PROFILE_MODE ? "profile" : "baseline",
+    harnessVersion: "desktop-open-stage2-v3",
+    injectionPath: window.__desktopPerfEvalFallback
+      ? "on_page_load-finished-eval"
+      : window.__desktopPerfPluginInjected ? "tauri-plugin-js_init_script" : "unknown",
+    status: "starting",
+    startedAt: timeOrigin,
+    page: {url: window.location.href, userAgent: navigator.userAgent, platform: navigator.platform, dpr: window.devicePixelRatio},
+    milestones: [],
+    rounds: [],
+    longTasks: [],
+    frameGaps: [],
+    frameGapExclusions: {background: 0, unfocused: 0, roundNotCalibrated: 0, transitions: 0},
+    consoleErrors: [],
+    runtimeErrors: [],
+    failures: [],
+    cpu: Object.create(null),
+    profile: {arrayFrom: {count: 0, totalMs: 0, maxMs: 0}, objectFreeze: {count: 0, totalMs: 0, maxMs: 0}},
+    currentRound: 0,
+    phase: "boot",
+    startTime: null,
+    reportSent: false,
+  };
+  const rootBridgeDescriptor = Object.getOwnPropertyDescriptor(window, "__TAURI_INTERNALS__");
+  const invokeDescriptor = Object.getOwnPropertyDescriptor(window.__TAURI_INTERNALS__ ?? {}, "invoke");
+  state.page.tauriBridge = {
+    rootWritable: rootBridgeDescriptor?.writable ?? null,
+    rootConfigurable: rootBridgeDescriptor?.configurable ?? null,
+    invokeWritable: invokeDescriptor?.writable ?? null,
+    invokeConfigurable: invokeDescriptor?.configurable ?? null,
+    invokeType: typeof window.__TAURI_INTERNALS__?.invoke,
+  };
+  window.__desktopPerf = state;
+  function isActiveVisible(node) {
+    if (!node || !node.isConnected || !node.getClientRects().length) return false;
+    const rect = node.getBoundingClientRect();
+    if (rect.width <= 0 || rect.height <= 0) return false;
+    for (let ancestor = node; ancestor && ancestor.nodeType === 1; ancestor = ancestor.parentElement) {
+      if (ancestor.hidden || ancestor.inert || ancestor.getAttribute("aria-hidden") === "true") return false;
+      const style = getComputedStyle(ancestor);
+      if (style.display === "none" || style.visibility === "hidden" || Number(style.opacity) === 0) return false;
+    }
+    return true;
+  }
+  const activeAll = selector => [...document.querySelectorAll(selector)].filter(isActiveVisible);
+  const activeOne = selector => activeAll(selector)[0] ?? null;
+  function progressSnapshot() {
+    return {
+      url: window.location.href,
+      readyState: document.readyState,
+      probePresent: true,
+      status: state.status,
+      phase: state.phase,
+      currentRound: state.currentRound || null,
+      invokeReady: typeof window.__TAURI_INTERNALS__?.invoke === "function",
+      tauriBridge: state.page.tauriBridge,
+      errors: state.runtimeErrors.length + state.consoleErrors.length + state.failures.length,
+      activeUiPages: activeAll(".ui-page").length,
+      activeWelcomeRows: activeAll(".project-entry").length,
+      activeToolbars: activeAll(".workbench-toolbar").length,
+      activeTimelineRows: activeAll(".outline-design-entry").length,
+      activeCanvases: activeAll(".timeline-canvas-frame").length,
+    };
+  }
+  function sendProgress(phase, details = {}, retry = 0) {
+    const payload = {phase, atMs: performance.now(), round: state.currentRound || null, details, snapshot: progressSnapshot()};
+    const invoke = window.__TAURI_INTERNALS__?.invoke;
+    if (typeof invoke === "function") {
+      Promise.resolve(invoke("desktop_perf_progress", {payload})).catch(error => {
+        state.runtimeErrors.push({atMs: performance.now(), message: `progress IPC failed: ${String(error)}`});
+      });
+    } else if (retry < 400) {
+      setTimeout(() => sendProgress(phase, details, retry + 1), 25);
+    } else {
+      state.runtimeErrors.push({atMs: performance.now(), message: "Tauri invoke bridge did not appear for progress reporting"});
+    }
+  }
+  sendProgress("probe-boot");
+  window.__desktopProbeCpu = (label, milliseconds) => {
+    if (typeof label !== "string" || !Number.isFinite(milliseconds)) return;
+    const total = state.cpu[label] ??= {count: 0, totalMs: 0, maxMs: 0};
+    total.count++;
+    total.totalMs += milliseconds;
+    total.maxMs = Math.max(total.maxMs, milliseconds);
+  };
+
+  function recordProfile(bucket, elapsed) {
+    bucket.count++;
+    bucket.totalMs += elapsed;
+    bucket.maxMs = Math.max(bucket.maxMs, elapsed);
+  }
+
+  if (PROFILE_MODE) {
+    const originalArrayFrom = Array.from;
+    Array.from = function (...args) {
+      const started = performance.now();
+      try { return originalArrayFrom.apply(this, args); }
+      finally { recordProfile(state.profile.arrayFrom, performance.now() - started); }
+    };
+    const originalFreeze = Object.freeze;
+    Object.freeze = function (...args) {
+      const started = performance.now();
+      try { return originalFreeze.apply(this, args); }
+      finally { recordProfile(state.profile.objectFreeze, performance.now() - started); }
+    };
+  }
+
+  function formatError(value) {
+    if (value instanceof Error) return `${value.name}: ${value.message}`;
+    try { return JSON.stringify(value); } catch { return String(value); }
+  }
+  window.addEventListener("error", event => {
+    state.runtimeErrors.push({atMs: performance.now(), message: event.message || formatError(event.error)});
+  });
+  window.addEventListener("unhandledrejection", event => {
+    state.runtimeErrors.push({atMs: performance.now(), message: formatError(event.reason)});
+  });
+  const originalConsoleError = console.error.bind(console);
+  console.error = (...args) => {
+    state.consoleErrors.push({atMs: performance.now(), message: args.map(formatError).join(" ").slice(0, 1000)});
+    originalConsoleError(...args);
+  };
+  try {
+    new PerformanceObserver(list => {
+      for (const entry of list.getEntries()) state.longTasks.push({startMs: entry.startTime, durationMs: entry.duration});
+    }).observe({type: "longtask", buffered: true});
+  } catch {}
+
+  let previousFrame = null;
+  let foregroundTransitionSinceFrame = false;
+  window.addEventListener("blur", () => { foregroundTransitionSinceFrame = true; });
+  window.addEventListener("focus", () => { foregroundTransitionSinceFrame = true; });
+  document.addEventListener("visibilitychange", () => { foregroundTransitionSinceFrame = true; });
+  function sampleFrame(timestamp) {
+    const visible = document.visibilityState === "visible";
+    const focused = document.hasFocus();
+    if (previousFrame !== null) {
+      const gap = timestamp - previousFrame.timestamp;
+      const sameRound = previousFrame.round === state.currentRound;
+      const calibrated = state.currentRound > 0 && state.currentRound === state.rounds.length + 1;
+      if (!visible) state.frameGapExclusions.background++;
+      else if (!focused) state.frameGapExclusions.unfocused++;
+      else if (foregroundTransitionSinceFrame) state.frameGapExclusions.transitions++;
+      else if (!sameRound || !calibrated || !previousFrame.visible || !previousFrame.focused) state.frameGapExclusions.roundNotCalibrated++;
+      else if (gap > 0) state.frameGaps.push({
+        atMs: timestamp,
+        round: state.currentRound,
+        phase: state.phase,
+        gapMs: gap,
+        visibilityState: document.visibilityState,
+        hasFocus: focused,
+        foregroundCalibrated: true,
+      });
+    }
+    previousFrame = {timestamp, visible, focused, round: state.currentRound};
+    foregroundTransitionSinceFrame = false;
+    requestAnimationFrame(sampleFrame);
+  }
+  requestAnimationFrame(sampleFrame);
+
+  function mark(name, details = {}) {
+    const entry = {name, atMs: performance.now(), round: state.currentRound || null, phase: state.phase, ...details};
+    state.milestones.push(entry);
+    if (["dom-content-loaded", "welcome-row-ready", "round-start", "project-open-click", "workbench-toolbar-ready", "timeline-list-ready", "all-data-ready", "foreground-native-state", "first-timeline-canvas-ready", "second-timeline-ready", "first-timeline-restored", "project-returned-to-welcome"].includes(name)) {
+      sendProgress(name, details);
+    }
+    return entry.atMs;
+  }
+  const delay = milliseconds => new Promise(resolve => setTimeout(resolve, milliseconds));
+  function waitForAnimationFrames(timeoutMs = 1500) {
+    return new Promise((resolve, reject) => {
+      const timeout = setTimeout(() => reject(new Error(`two animation frames timed out after ${timeoutMs}ms`)), timeoutMs);
+      requestAnimationFrame(firstFrame => requestAnimationFrame(secondFrame => {
+        clearTimeout(timeout);
+        resolve({firstFrame, secondFrame, elapsedMs: secondFrame - firstFrame});
+      }));
+    });
+  }
+  function documentFocusSnapshot() {
+    return {visibilityState: document.visibilityState, hasFocus: document.hasFocus()};
+  }
+
+  async function waitFor(predicate, label, timeoutMs = WAIT_MS) {
+    const end = performance.now() + timeoutMs;
+    let lastError;
+    while (performance.now() < end) {
+      try {
+        const result = predicate();
+        if (result) return result;
+      } catch (error) { lastError = error; }
+      await delay(25);
+    }
+    throw new Error(`${label} timed out after ${timeoutMs}ms${lastError ? `: ${formatError(lastError)}` : ""}`);
+  }
+
+  function textOf(node) { return node?.innerText?.replace(/\s+/g, " ").trim() ?? ""; }
+  function findTimeline(title) {
+    return activeAll(".outline-design-entry").find(entry => textOf(entry).includes(title)) ?? null;
+  }
+  function rowsReady() {
+    const entries = activeAll(".outline-design-entry");
+    const loading = activeAll(".outline-design-list-status").some(node => textOf(node).includes("正在读取时间线"));
+    const error = activeOne(".outline-design-list-status[role=alert]");
+    return entries.length === 26 && !loading && !error;
+  }
+  function timelineDataSnapshot() {
+    const entries = activeAll(".outline-design-entry");
+    const rows = entries.map(entry => {
+      const title = textOf(entry.querySelector(".outline-design-entry-heading strong"));
+      const countText = textOf(entry.querySelector(".outline-design-entry-count"));
+      const eventCount = Number.parseInt(countText.match(/[\d,]+/)?.[0]?.replaceAll(",", "") ?? "", 10);
+      const period = textOf(entry.querySelector(".outline-design-entry-period"));
+      return {title, eventCount: Number.isFinite(eventCount) ? eventCount : null, period};
+    });
+    const totalEventCount = rows.reduce((sum, row) => sum + (row.eventCount ?? 0), 0);
+    const complete = rows.length === EXPECTED_TIMELINE_COUNT
+      && rows.every(row => row.title && row.eventCount !== null && row.period && !row.period.includes("时间待定"))
+      && totalEventCount === EXPECTED_EVENT_COUNT;
+    return {rows, totalEventCount, complete};
+  }
+  function visibleTimelineTitles() {
+    const overlay = activeOne('.timeline-events-overlay[data-active="true"]');
+    if (!overlay) return [];
+    return [...overlay.querySelectorAll(".timeline-event-title")].filter(node => {
+      if (!node.isConnected || !node.getClientRects().length) return false;
+      const rect = node.getBoundingClientRect();
+      if (rect.width <= 0 || rect.height <= 0) return false;
+      for (let ancestor = node; ancestor && ancestor.nodeType === 1; ancestor = ancestor.parentElement) {
+        if (ancestor.hidden || ancestor.inert) return false;
+        const style = getComputedStyle(ancestor);
+        if (style.display === "none" || style.visibility === "hidden" || Number(style.opacity) === 0) return false;
+      }
+      return true;
+    });
+  }
+  function activeAxisAnchorCount() {
+    return activeOne('.timeline-events-overlay[data-active="true"]')
+      ?.querySelectorAll(".timeline-event-axis-marker").length ?? 0;
+  }
+  function canvasViewportSnapshot(surface) {
+    if (!surface) return null;
+    return {
+      centerX: Number(surface.getAttribute("data-canvas-center-x")),
+      centerY: Number(surface.getAttribute("data-canvas-center-y")),
+      zoom: Number(surface.getAttribute("data-canvas-zoom")),
+    };
+  }
+  function domSnapshot() {
+    const toolbar = activeOne(".workbench-toolbar [data-toolbar-project-name]");
+    const selected = activeOne('.outline-design-entry[aria-pressed="true"]');
+    const canvas = activeOne(".timeline-canvas-frame");
+    const axis = activeOne(".timeline-axis-svg");
+    return {
+      title: document.title,
+      readyState: document.readyState,
+      activeUiPages: activeAll(".ui-page").length,
+      welcomeRows: activeAll(".project-entry").length,
+      toolbar: Boolean(toolbar),
+      projectName: textOf(toolbar),
+      outlineRows: activeAll(".outline-design-entry").length,
+      outlineLoading: activeAll(".outline-design-list-status").map(textOf),
+      selectedTimeline: textOf(selected),
+      canvas: Boolean(canvas),
+      axis: axis?.getAttribute("aria-label") ?? null,
+      tauriBridge: state.page.tauriBridge,
+    };
+  }
+
+  function durationStats(values) {
+    if (!values.length) return {count: 0, meanMs: null, medianMs: null, p95Ms: null, maxMs: null};
+    const sorted = [...values].sort((left, right) => left - right);
+    const at = percentile => sorted[Math.min(sorted.length - 1, Math.ceil(percentile * sorted.length) - 1)];
+    return {
+      count: sorted.length,
+      meanMs: sorted.reduce((sum, value) => sum + value, 0) / sorted.length,
+      medianMs: at(0.5),
+      p95Ms: at(0.95),
+      maxMs: sorted[sorted.length - 1],
