          "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
        },
        "status.successBackground": {
          "type": "string",
          "description": "成功提示的柔和承载背景；不是操作或选中底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "status.successForeground": {
          "type": "string",
