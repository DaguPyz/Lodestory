        },
        "status.danger": {
          "type": "string",
          "description": "失败状态文字与图标",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "status.info": {
          "type": "string",
          "description": "信息状态文字与图标",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "overlay.scrim": {
          "type": "string",
          "description": "模态浮层后方遮罩",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
        },
        "shadow.softAmbient": {
          "type": "string",
          "description": "柔和浮层的环境阴影颜色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
        },
        "shadow.softKey": {
