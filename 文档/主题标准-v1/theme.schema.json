{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lodestory:theme-file:1",
  "title": "Lodestory v1 主题文件",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "type",
    "colors"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 256
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 144,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "type": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface.root": {
          "type": "string",
          "description": "整个视图最底层的承载背景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "surface.content": {
          "type": "string",
          "description": "主要内容的中性承载背景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "surface.secondary": {
          "type": "string",
          "description": "辅助内容的中性承载背景，与主要内容形成层次",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "surface.tonal": {
          "type": "string",
          "description": "同层内容分组或操作上下文的中性色调变化背景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "surface.control": {
          "type": "string",
          "description": "可操作或可编辑对象的中性承载背景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "surface.floating": {
          "type": "string",
          "description": "覆盖在其他内容之上的浮动承载背景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.primary": {
          "type": "string",
          "description": "主要界面文字",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.secondary": {
          "type": "string",
          "description": "辅助说明与一般图标",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.muted": {
          "type": "string",
          "description": "弱化元信息",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.placeholder": {
          "type": "string",
          "description": "输入占位文字",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.disabled": {
          "type": "string",
          "description": "不可用状态文字",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.reading": {
          "type": "string",
          "description": "连续阅读的正文前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "text.onAction": {
          "type": "string",
          "description": "实色操作表面上的文字",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "border.divider": {
          "type": "string",
          "description": "必要结构分隔线",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "border.decoration": {
          "type": "string",
          "description": "非必要装饰边界",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "border.default": {
          "type": "string",
          "description": "中性承载面上的常态必要边界；交互反馈使用强边界",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "border.strong": {
          "type": "string",
          "description": "识别可操作对象所需的必要边界",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "accent.foreground": {
          "type": "string",
          "description": "强调文字与图标",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "accent.indicator": {
          "type": "string",
          "description": "必要的强调指示；普通控件选中标记使用对应状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "focus.ring": {
          "type": "string",
          "description": "键盘焦点环",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "caret.foreground": {
          "type": "string",
          "description": "文本输入位置指示前景，默认沿用阅读正文",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "selection.background": {
          "type": "string",
          "description": "文字选区底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "selection.foreground": {
          "type": "string",
          "description": "文字选区前景，默认沿用主要文字",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.hoverBackground": {
          "type": "string",
          "description": "悬停状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.hoverForeground": {
          "type": "string",
          "description": "悬停状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.pressedBackground": {
          "type": "string",
          "description": "按下状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.pressedForeground": {
          "type": "string",
          "description": "按下状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.selectedBackground": {
          "type": "string",
          "description": "选中状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.selectedForeground": {
          "type": "string",
          "description": "选中状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.selectedHoverBackground": {
          "type": "string",
          "description": "悬停选中状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.selectedHoverForeground": {
          "type": "string",
          "description": "悬停选中状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.selectedPressedBackground": {
          "type": "string",
          "description": "按下选中状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.selectedPressedForeground": {
          "type": "string",
          "description": "按下选中状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.inactiveSelectedBackground": {
          "type": "string",
          "description": "失焦后的选中状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.inactiveSelectedForeground": {
          "type": "string",
          "description": "失焦后的选中状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.disabledBackground": {
          "type": "string",
          "description": "禁用状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.disabledForeground": {
          "type": "string",
          "description": "禁用状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.disabledSelectedBackground": {
          "type": "string",
          "description": "禁用且选中状态底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.disabledSelectedForeground": {
          "type": "string",
          "description": "禁用且选中状态前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "state.disabledBorder": {
          "type": "string",
          "description": "禁用对象的边界",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "action.background": {
          "type": "string",
          "description": "主操作底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "action.hoverBackground": {
          "type": "string",
          "description": "主操作悬停底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "action.pressedBackground": {
          "type": "string",
          "description": "主操作按下底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "action.foreground": {
          "type": "string",
          "description": "主操作前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "danger.background": {
          "type": "string",
          "description": "危险操作底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "danger.hoverBackground": {
          "type": "string",
          "description": "危险操作悬停底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "danger.pressedBackground": {
          "type": "string",
          "description": "危险操作按下底色",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "danger.foreground": {
          "type": "string",
          "description": "危险操作前景",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "status.success": {
          "type": "string",
          "description": "成功状态文字与图标",
          "pattern": "^#[0-9A-Fa-f]{6}(?:[fF]{2})?$"
        },
        "status.warning": {
          "type": "string",
