  "measurementScript": "import {build,version as esbuildVersion} from 'esbuild';\nimport {readFile,writeFile,mkdir} from 'node:fs/promises';\nimport {gzipSync} from 'node:zlib';\nimport {createHash} from 'node:crypto';\nconst root=new URL('.',import.meta.url);const meta=JSON.parse(await readFile(new URL('metadata.json',root),'utf8'));\nconst cases=[\n ['slate-core',['slate']],\n ['slate-react-basics',['slate','slate-dom','slate-react','slate-history']],\n ['plate-core',['platejs']],\n ['plate-react-basics',['platejs','platejs/react']],\n ['tiptap-core',['@tiptap/core']],\n ['tiptap-react-starter',['@tiptap/core','@tiptap/react','@tiptap/starter-kit']],\n ['lexical-core',['lexical']],\n ['lexical-react-basics',['lexical','@lexical/rich-text','@lexical/history','@lexical/list','@lexical/link','@lexical/react/LexicalComposer','@lexical/react/LexicalRichTextPlugin','@lexical/react/LexicalContentEditable','@lexical/react/LexicalHistoryPlugin','@lexical/react/LexicalOnChangePlugin','@lexical/react/LexicalErrorBoundary']]\n];\nawait mkdir(new URL('bundles/',root),{recursive:true});\nconst results=[];\nfor(const [name,entries] of cases){\n const contents=entries.map((e,i)=>`import * as m${i} from ${JSON.stringify(e)};`).join('\\n')+'\\nglobalThis.__editorSizeProbe=['+entries.map((e,i)=>`m${i}`).join(',')+'];';\n try{\n  const output=await build({stdin:{contents,resolveDir:new URL('.',root).pathname,sourcefile:name+'.js',loader:'js'},bundle:true,minify:true,format:'esm',platform:'browser',target:'es2022',write:false,metafile:true,treeShaking:true,legalComments:'none',define:{'process.env.NODE_ENV':'\"production\"'},external:['react','react/*','react-dom','react-dom/*'],logLevel:'silent'});\n  const js=output.outputFiles[0].contents;const gz=gzipSync(js,{level:9});\n  await writeFile(new URL('bundles/'+name+'.js',root),js);await writeFile(new URL('bundles/'+name+'.js.gz',root),gz);\n  await writeFile(new URL('bundles/'+name+'.meta.json',root),JSON.stringify(output.metafile,null,2));\n  const r={name,entries,minifiedBytes:js.length,gzipBytes:gz.length,minifiedKiB:+(js.length/1024).toFixed(1),gzipKiB:+(gz.length/1024).toFixed(1),sha256:createHash('sha256').update(js).digest('hex'),inputCount:Object.keys(output.metafile.inputs).length};results.push(r);console.log(JSON.stringify(r));\n }catch(error){const r={name,entries,error:error.errors||String(error)};results.push(r);console.log(JSON.stringify(r));}\n}\nconst report={measuredAt:new Date().toISOString(),esbuildVersion,nodeVersion:process.version,method:'All public exports of the specified entries are retained on globalThis; esbuild browser ESM production ES2022, minify, legalComments:none, gzip level 9. React/ReactDOM external. Includes resolved transitive code; no CSS/toolbars/icons/business integration. These are selected package-scope measurements, not equal-feature completed editors or runtime performance benchmarks. Core excludes separate rendering adapters/features where the library separates them.',metadata:meta,results};\nawait writeFile(new URL('size-report.json',root),JSON.stringify(report,null,2)+'\\n');\n",
